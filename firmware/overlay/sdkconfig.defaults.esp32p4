# Jarvis 2026-10-18: Waveshare ESP32-P4-WIFI6-Touch-LCD-7B.
# Base: sdkconfig.defaults.esp32p4 de xiaozhi-esp32 v2.3.0 + la variante 7B de
# su config.json, más lo de Jarvis que en la S3 vive en sdkconfig.defaults.esp32s3.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_7B=y

# Flash de 32 MB. La tabla es la de 16 MB de Jarvis (trae la partición de
# coredump) y entra de sobra.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=n
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y

# Revisión del chip: el default de ESP-IDF 5.5.2 es "< 3.0". Para un P4 de
# revisión 3.x, firmware/build.sh agrega CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
# cuando jarvis.env tiene JARVIS_P4_CHIP_REV=3. Un binario de una no arranca
# en la otra.

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# WiFi por el ESP32-C6 de la placa (esp_hosted por SDIO).
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

# Cancelación de eco en la placa, con la referencia del ES7210.
CONFIG_USE_DEVICE_AEC=y
CONFIG_USE_WECHAT_MESSAGE_STYLE=n

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_USE_MICRO_WAKE_WORD=y
CONFIG_MICRO_WAKE_WORD_PROBABILITY_CUTOFF=80

# --- Lo de Jarvis (igual que en la S3) ---
CONFIG_APOLLO_PROTOCOL=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
